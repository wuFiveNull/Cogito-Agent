# Core runtime overrides. The canonical persistent configuration is
# ~/.cogito/config.toml; environment variables take precedence.

# COGITO_DB_PATH=~/.cogito/cogito.db
# COGITO_LOG_LEVEL=INFO
# COGITO_LOG_FORMAT=json
# COGITO_LOG_MAX_SIZE=10485760
# COGITO_LOG_BACKUP_COUNT=5
# COGITO_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# COGITO_MAX_REQUEST_SIZE=10485760
# COGITO_CSRF_ENABLED=true

# Console/API security. Set non-empty values outside local development.
# COGITO_API_KEY=replace-with-a-random-secret
# COGITO_CSRF_TOKEN=replace-with-a-random-secret

# Optional runtime controls.
# COGITO_WORKSPACE_ROOT=~/.cogito/workspace
# COGITO_RATE_LIMIT_ENABLED=1
# COGITO_RATE_LIMIT_PER_MINUTE=60

# Model provider compatibility variables. Prefer model.secret_ref in
# ~/.cogito/config.toml for API keys; these remain supported by adapters.

# MODEL_API_KEY=sk-your-key-here
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# Local Ollama (OpenAI-compatible mode):
# MODEL_API_KEY=
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3.2

# Embedding API key for dense semantic memory retrieval (BAAI/bge-m3).
# Used when memory.embedding.api_key_env is set to SILICONFLOW_API_KEY.
# SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here
